{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "app/src/data/types.ts",
    "app/src/data/credits.ts",
    "app/src/data/citations.ts",
    "app/src/data/software.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
